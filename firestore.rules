rules_version = '2';

// =========================================================
// firestore.rules — 서버 데이터 보안 규칙 (진짜 "규칙"은 여기, add-real-server D3)
// ---------------------------------------------------------
// 앱 코드는 누구나 고쳐 쓸 수 있어서, 남의 대화·위치를 막는 일은 전부 여기서 해요.
// 문서 이름 규칙은 src/data/server/firebase/paths.js와 같아야 해요.
//   두 사람 사이 문서: "작은 uid_큰 uid" (pairId)
//   좋아요: "보낸 uid_받은 uid", 차단: "신고한 uid_신고당한 uid"
// 서버 함수(functions/)는 관리자 권한이라 이 규칙을 거치지 않아요 (24시간 정리, 회원탈퇴, 친구 소식 복사).
// 친구가 많아져도 구독 수가 늘지 않게: 메시지 members, typing/{받는 사람}, feeds/{나}/friends
// =========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 시험용 익명 계정은 처음 로그인한 지 하루(24시간)까지만 (앱: src/data/login/GoogleLogin.js ANON_LIFETIME_MS)
    function anonExpired() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.time.toMillis() > request.auth.token.auth_time * 1000 + 86400000;
    }
    function signedIn() {
      return request.auth != null && !anonExpired();
    }
    function me() {
      return request.auth.uid;
    }
    function pairOf(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function docPath(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }
    function isFriend(other) {
      return exists(docPath('friendships', pairOf(me(), other)));
    }
    // 둘 중 한 명이라도 상대를 신고했으면 서로 못 읽고 못 써요 (SYNC-50)
    function isBlocked(other) {
      return exists(docPath('blocks', me() + '_' + other)) || exists(docPath('blocks', other + '_' + me()));
    }
    function inPair(pair) {
      return me() in pair.split('_');
    }
    function otherIn(pair) {
      return pair.split('_')[0] == me() ? pair.split('_')[1] : pair.split('_')[0];
    }
    function isNowish(at) {   // 앞으로 1분까지 (기기 시계 차이)
      return at is int && at <= request.time.toMillis() + 60000;
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    // 이용정지(위반 2회 7일, 3회 이상 영구) 중이면 아무것도 보내거나 올릴 수 없어요
    // 기준은 src/data/sanctionRules.js, 기록은 서버 함수 moderateMessage나 운영자가 써요
    // ---------- 운영자 (운영자 사이트 admin.html, 주소·사용법은 docs/guides/admin-guide.md) ----------
    // 운영자는 구글이 아니라 "발급받은 12자리 아이디"로 로그인해요 (속으로는 이메일/비밀번호 로그인:
    //   이메일 = 아이디를 알아볼 수 없게 바꾼 값(idHash) + ADMIN_EMAIL_DOMAIN, 비밀번호 = 아이디)
    // 운영자: 아이디로 로그인했고(password) + 운영자 명단(admins/{uid})에 있을 때만
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(docPath('admins', me()));
    }
    // 총관리자: 운영자 중 role이 owner인 사람 (여러 명 가능 — 총관리자가 총관리자 아이디도 발급할 수 있어요)
    function isOwnerAdmin() {
      return isAdmin() && get(docPath('admins', me())).data.role == 'owner';
    }
    // 첫 총관리자 아이디를 만들 때 쓰는 구글 계정 (여러 개 적어도 돼요. 첫 아이디를 발급한 뒤에는 비워도 돼요)
    function isBootstrapOwner() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['unidevpeer@gmail.com'];
    }
    // 회원 삭제는 총관리자만 (되돌릴 수 없어서)
    function canPurge() {
      return isOwnerAdmin();
    }
    function canIssueIds() {
      return isOwnerAdmin() || isBootstrapOwner();
    }
    // 처리한 사람 표시: { uid, name, idMask } — uid는 꼭 나 자신
    function signedBy(by) {
      return by.uid == me() && by.name is string && by.idMask is string;
    }

    function isBanned() {
      return exists(docPath('moderation', me()))
        && (get(docPath('moderation', me())).data.get('isPermanent', false) == true
          || get(docPath('moderation', me())).data.get('bannedUntil', 0) > request.time.toMillis());
    }

    // ---------- 사람 (공개 정보: 아이디, 닉네임, 나이, 사진, 관심사, 소리 받기 권한, 위치 공유 여부) ----------
    match /users/{uid} {
      allow get: if (signedIn() && (uid == me() || !isBlocked(uid))) || isAdmin();
      // 스와이프용 목록 (가입한 사람 랜덤): 한 번에 100명까지만. 신고·차단한 사람은 앱이 목록에서 빼요
      allow list: if signedIn() && request.query.limit <= 100;
      // 가입: 아이디 문서를 같이 만들어야만 (아이디 중복 막기, ACC-S3)
      allow create: if signedIn() && uid == me()
        && request.resource.data.handle is string
        && getAfter(docPath('handles', request.resource.data.handle)).data.uid == me()
        && request.resource.data.name is string && request.resource.data.name.size() <= 12;
      // 아이디는 못 바꿔요
      allow update: if signedIn() && uid == me()
        && request.resource.data.handle == resource.data.handle
        && request.resource.data.name.size() <= 12
        && request.resource.data.get('photos', []).size() <= 10
        && request.resource.data.get('tags', []).size() <= 5
        && request.resource.data.get('region', '').size() <= 40
        && request.resource.data.get('country', '').size() <= 2;
      allow delete: if signedIn() && uid == me();   // 무료 모드 회원탈퇴 (서버 함수 모드는 deleteAccount)
      // 운영자 사이트 회원 관리: 목록은 운영자 모두, 삭제는 총관리자만
      allow list: if isAdmin();
      allow delete: if canPurge();

      // 비공개 정보 (생년월일·이메일): 나만 (+ 운영자는 읽기만)
      // email: 로그인한 계정 이메일 (운영자가 신고를 확인할 때)
      match /private/{docId} {
        allow read, write: if signedIn() && uid == me();
        allow read: if isAdmin();
        allow delete: if canPurge();
      }
    }

    // ---------- 아이디 (문서 하나 = 아이디 하나) ----------
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn()
        && handle.matches('^[a-zA-Z0-9]{4,15}$')
        && request.resource.data.uid == me()
        && getAfter(docPath('users', me())).data.handle == handle;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == me();   // 무료 모드 회원탈퇴: 내 아이디만
      allow delete: if canPurge();
    }

    // ---------- 좋아요 (SYNC-10~12) ----------
    match /likes/{likeId} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && likeId == me() + '_' + request.resource.data.to
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && isNowish(request.resource.data.at)
        && !isBlocked(request.resource.data.to)
        && !isBanned();
      // 보낸 사람은 취소, 받은 사람은 거절할 수 있어요
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow read, delete: if canPurge();
      allow update: if false;
    }

    // ---------- 친구 ----------
    // 상대가 나에게 좋아요를 보낸 상태일 때만 친구가 될 수 있어요 ("친구할까요?" 또는 서로 좋아요)
    match /friendships/{pair} {
      allow get: if signedIn() && inPair(pair);
      // 목록(내 친구 전부)은 문서 이름으로 확인할 수 없어서, 문서 안 users에 내가 있는지로 확인해요
      // (앱의 질문이 where("users", "array-contains", 나)라서 서버가 허락할 수 있어요)
      allow list: if signedIn() && me() in resource.data.users;
      allow create: if signedIn() && inPair(pair)
        && pair == pairOf(me(), otherIn(pair))
        && request.resource.data.users == [pair.split('_')[0], pair.split('_')[1]]
        && request.resource.data.by == me()
        && exists(docPath('likes', otherIn(pair) + '_' + me()))
        && !isBlocked(otherIn(pair))
        && !isBanned();
      allow update: if false;
      allow delete: if signedIn() && inPair(pair);
      allow list, delete: if canPurge();
    }

    // ---------- 대화 (친구만, SYNC-20~24) ----------
    match /chats/{pair}/messages/{messageId} {
      allow read: if signedIn() && inPair(pair) && isFriend(otherIn(pair)) && !isBlocked(otherIn(pair));
      allow create: if signedIn() && inPair(pair) && isFriend(otherIn(pair)) && !isBlocked(otherIn(pair))
        && request.resource.data.from == me()
        // members·to: 받는 사람이 모든 대화를 질문 하나로 구독하려고 (아래 {path=**}/messages)
        && request.resource.data.to == otherIn(pair)
        && request.resource.data.members == [pair.split('_')[0], pair.split('_')[1]]
        // 사진 보내기는 초기 안전 장치로 막아요 (앱의 features.canSendPhoto와 같이 켜기: 'photo' 다시 넣기)
        && request.resource.data.type in ['text', 'voice']
        && request.resource.data.isSaved == false
        && request.resource.data.get('flags', []) is list
        && !isBanned()
        && isNowish(request.resource.data.at)
        && (request.resource.data.type != 'text' || (request.resource.data.text is string && request.resource.data.text.size() <= 1000));
      // 두 사람 다 "저장"만 바꿀 수 있어요 (SYNC-22)
      allow update: if signedIn() && inPair(pair) && isFriend(otherIn(pair)) && onlyChanges(['isSaved']);
      allow delete: if canPurge();   // 24시간 정리는 서버 함수, 회원 삭제는 총관리자
    }

    // 모든 대화 한 번에 구독 (collectionGroup "messages", where members array-contains 나)
    // 내가 그 대화의 두 사람 중 하나일 때만. 질문에 members 조건이 있어야 허락돼요
    match /{path=**}/messages/{messageId} {
      allow list: if signedIn() && me() in resource.data.members;
      allow list: if canPurge();   // 회원 삭제: 그 사람이 주고받은 메시지 찾기
    }

    // 회원 삭제: 그 사람이 친구 스토리에 누른 좋아요 찾기 (stories/{uid}/likes/{그 사람 uid})
    match /{path=**}/likes/{likeId} {
      allow list: if canPurge();
    }

    // ---------- 입력 중 (받는 사람마다 문서 하나: typing/{받는 사람 uid}) ----------
    // 나는 내 문서만 읽고, 친구는 내 문서의 "자기 uid 칸"에만 시각을 써요
    match /typing/{uid} {
      allow read: if signedIn() && uid == me();
      allow create: if signedIn() && uid != me() && isFriend(uid) && !isBlocked(uid)
        && request.resource.data.keys().hasOnly([me()])
        && isNowish(request.resource.data[me()]);
      allow update: if signedIn() && uid != me() && isFriend(uid) && !isBlocked(uid)
        && onlyChanges([me()])
        && isNowish(request.resource.data[me()]);
      allow delete: if canPurge();
    }

    // ---------- 친구 소식 (서버 함수 fanOut*이 복사, 나만 읽음) ----------
    match /feeds/{uid}/friends/{friendUid} {
      allow read: if signedIn() && uid == me();
      allow write: if false;
    }

    // ---------- 스토리 (친구만 보기, SYNC-40~42) ----------
    match /stories/{uid} {
      allow read: if signedIn() && (uid == me() || (isFriend(uid) && !isBlocked(uid)));
      allow create, update: if signedIn() && uid == me() && !isBanned();
      allow delete: if signedIn() && uid == me();
      allow delete: if canPurge();

      match /likes/{fromUid} {
        allow read: if signedIn() && (uid == me() || fromUid == me());
        allow create, update: if signedIn() && fromUid == me() && isFriend(uid) && isNowish(request.resource.data.at);
        allow delete: if signedIn() && fromUid == me();
        allow read, delete: if canPurge();
      }
    }

    // ---------- 정확한 위치 (친구만, SYNC-30~31) — add-google-map 뒤에 앱이 씀 ----------
    match /locations/{uid} {
      allow read: if signedIn() && (uid == me() || (isFriend(uid) && !isBlocked(uid)));
      allow write: if signedIn() && uid == me();
      allow delete: if canPurge();
    }

    // ---------- 신고와 차단 ----------
    match /reports/{reportId} {
      // message: 길게 눌러 신고한 그 메시지 (메시지는 24시간 뒤 지워져도 신고 기록에는 남아요)
      // note: 신고한 사람이 쓴 자세한 내용(선택), photo: 첨부 사진(선택, 작게 줄인 사진 글자)
      allow create: if signedIn() && request.resource.data.from == me() && request.resource.data.target != me()
        && (!('message' in request.resource.data) || request.resource.data.message.text.size() <= 1000)
        && request.resource.data.get('note', '').size() <= 500
        && request.resource.data.get('photo', '').size() <= 400000
        && !('status' in request.resource.data);
      // 운영자만 보고, "처리 완료" 표시만 바꿀 수 있어요 (신고 내용은 못 고쳐요)
      allow read: if isAdmin();
      // history: 지금까지 누가 무엇을 했는지 쌓아요 (처리한 사람 성명 + 아이디 일부)
      allow update: if isAdmin() && onlyChanges(['status', 'handledAt', 'handledBy', 'action', 'history'])
        && signedBy(request.resource.data.handledBy);
      allow delete: if false;
    }
    match /blocks/{blockId} {
      allow read: if signedIn() && (resource.data.blocker == me() || resource.data.blocked == me());
      allow create: if signedIn()
        && blockId == me() + '_' + request.resource.data.blocked
        && request.resource.data.blocker == me()
        && request.resource.data.kind in ['report', 'block'];
      // 차단만 풀 수 있어요 (신고는 못 풀어요)
      allow delete: if signedIn() && resource.data.blocker == me() && resource.data.kind == 'block';
      allow read, delete: if canPurge();
      allow update: if false;
    }

    // ---------- 소리 울리기 (친구만, 30초 제한은 앱에서) ----------
    // ---------- 위반 횟수·이용정지 (서버 함수와 운영자만 씀, 나만 읽음) ----------
    match /moderation/{uid} {
      allow read: if (signedIn() && uid == me()) || isAdmin();
      // 운영자 사이트의 경고·정지·영구정지 버튼 (모양은 src/data/sanctionRules.js와 같게)
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['warnings', 'bannedUntil', 'isPermanent', 'by', 'at'])
        && request.resource.data.warnings is int
        && request.resource.data.bannedUntil is int
        && request.resource.data.isPermanent is bool
        && signedBy(request.resource.data.by);
    }

    // ---------- 운영자 아이디 발급 · 운영자 명단 ----------
    // 발급한 아이디: 문서 이름 = idHash (아이디 원문은 어디에도 저장하지 않아요. 발급한 순간 화면에만 한 번 보여요)
    match /adminIds/{idHash} {
      allow get, list, delete: if canIssueIds();
      allow create: if canIssueIds() && idHash.size() == 40
        && request.resource.data.keys().hasOnly(['role', 'note', 'idMask', 'createdAt', 'createdBy', 'usedBy', 'usedAt', 'usedName'])
        && request.resource.data.role in ['admin', 'owner']
        && request.resource.data.usedBy == null;
      // 등록: 아직 아무도 안 쓴 아이디를, 그 아이디로 만든 내 계정으로 한 번만
      allow update: if request.auth != null
        && request.auth.token.email == idHash + '@admin.ururu.app'
        && resource.data.usedBy == null
        && request.resource.data.usedBy == me()
        && onlyChanges(['usedBy', 'usedAt', 'usedName'])
        && getAfter(docPath('admins', me())).data.idHash == idHash;
    }
    // 운영자 명단: 성명 · 닉네임 · 생년월일 · 아이디 일부(idMask) · 역할
    match /admins/{uid} {
      allow get: if (request.auth != null && uid == me()) || canIssueIds();
      allow list, delete: if canIssueIds();
      allow create: if request.auth != null && uid == me()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == request.resource.data.idHash + '@admin.ururu.app'
        && request.resource.data.keys().hasOnly(['name', 'nickname', 'birthDate', 'email', 'idHash', 'idMask', 'role', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && request.resource.data.nickname is string && request.resource.data.nickname.size() >= 1 && request.resource.data.nickname.size() <= 20
        && request.resource.data.birthDate is string
        && request.resource.data.email is string && request.resource.data.email.size() <= 100 && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && getAfter(docPath('adminIds', request.resource.data.idHash)).data.usedBy == me()
        && request.resource.data.role == get(docPath('adminIds', request.resource.data.idHash)).data.role;
      allow update: if false;
    }

    match /pings/{pingId} {
      allow create: if signedIn() && request.resource.data.from == me() && isFriend(request.resource.data.to) && !isBanned();
      allow read, delete: if signedIn() && resource.data.to == me();
      allow read, delete: if canPurge();
      allow update: if false;
    }

    // ---------- 회원 삭제 기록 (누가 언제 누구를 지웠는지, 운영자만 봐요, 고칠 수 없음) ----------
    match /deletions/{uid} {
      allow read: if isAdmin();
      allow create: if canPurge()
        && request.resource.data.keys().hasOnly(['handle', 'name', 'email', 'at', 'by'])
        && request.resource.data.handle is string
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.at is int
        && signedBy(request.resource.data.by);
      allow update, delete: if false;
    }
  }
}
