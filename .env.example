# .env.example — 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채워요 (.env는 git에 안 올라가요)
# 비워두면 시연 모드(가짜 서버)로 열려요. 채우면 진짜 서버(Firebase)로 열려요. (add-real-server D6)
# 값 받는 곳: Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) → SDK 설정 및 구성 (docs/guides/firebase-setup-guide.md 3번)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true 로 하면 내 컴퓨터 안의 가짜 Firebase(에뮬레이터)에 붙어요 (npm run emulators 먼저)
VITE_FIREBASE_EMULATOR=false

# 구글 지도 (add-google-map, docs/guides/google-maps-api-key-guide.md) — 아직 안 씀
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=

# 카카오 지도: developers.kakao.com → 내 앱 → 플랫폼 키 → JavaScript 키 (JavaScript SDK 도메인에 주소 등록 필요)
VITE_KAKAO_MAP_KEY=
# 서버 함수(Blaze 요금제)를 배포했을 때만 true. false면 무료 모드 (친구 정보 직접 읽기, 사진은 작게 문서에, 회원탈퇴도 앱이)
VITE_SERVER_FUNCTIONS=false
